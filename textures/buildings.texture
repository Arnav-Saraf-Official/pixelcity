      ]
    },

    "dock": {
      "size": [27, 18],
      "params": { "seed": 0, "wet": null, "crane": false },
      "ops": [
        { "op": "each", "as": "ty", "in": ["range", ["param", "th"]], "ops": [
          { "op": "each", "as": "tx", "in": ["range", ["param", "tw"]], "ops": [

            { "op": "if", "test": ["fn", "wet", ["var", "tx"], ["var", "ty"]], "then": [
              { "op": "rect", "x": ["*", ["var", "tx"], 9], "y": ["+", ["*", ["var", "ty"], 9], 1],
                "w": 9, "h": 7, "color": "#8b6a43" },
              { "op": "each", "as": "k", "in": [2, 4, 6], "ops": [
                { "op": "rect", "x": ["*", ["var", "tx"], 9], "y": ["+", ["*", ["var", "ty"], 9], ["var", "k"]],
                  "w": 9, "h": 1, "color": "#6e5233" }] },
              { "op": "pixel", "x": ["*", ["var", "tx"], 9], "y": ["+", ["*", ["var", "ty"], 9], 1], "color": "#3e2c1c" },
              { "op": "pixel", "x": ["+", ["*", ["var", "tx"], 9], 8], "y": ["+", ["*", ["var", "ty"], 9], 1], "color": "#3e2c1c" },
              { "op": "pixel", "x": ["*", ["var", "tx"], 9], "y": ["+", ["*", ["var", "ty"], 9], 7], "color": "#3e2c1c" },
              { "op": "pixel", "x": ["+", ["*", ["var", "tx"], 9], 8], "y": ["+", ["*", ["var", "ty"], 9], 7], "color": "#3e2c1c" },
              { "op": "berth", "x": ["var", "tx"], "y": ["var", "ty"] }
            ], "else": [
              { "op": "rect", "x": ["*", ["var", "tx"], 9], "y": ["*", ["var", "ty"], 9],
