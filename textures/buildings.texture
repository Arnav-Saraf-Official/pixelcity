{
  // ===================================================================
  // Buildings. Every type is a rule over its `seed`, so each plot gets a
  // stable variation without storing a sprite per building.
  //
  // Ops used for dynamic behaviour:
  //   win  - paints a window and records its pixel for night lighting
  //   park - records a parking slot (v: 1 = perpendicular, 0 = parallel)
  //   stat - status light position (carried by every type but metro/park/bus stop)
  //   berth - where boats moor at a dock
  //   spots - queue points for metro stations and bus stops
  //   mark  - records visitor points without painting
  // `wet(tx,ty)` is a function supplied by the caller, used by the dock.
  // ===================================================================
  "format": "texture/1",
  "name": "buildings",
  "tile": 9,

  "defs": {
    "roofs": ["#c0504d", "#d2763a", "#8e5ea2", "#4f7cac", "#5f8f3a", "#b5651d", "#a83f5f", "#3f7f7f"],
    "walls": ["#efe3c8", "#e6d3b3", "#dcd6d0", "#f3efe6", "#d9c3a5"],
    "grey": "#6f727a"
  },

  "textures": {
    "house": {
      "size": [9, 9],
      "params": {
        "seed": 0, "wet": null,
        "roof": ["pick", ["def", "roofs"], ["rnd"]],
        "wall": ["pick", ["def", "walls"], ["rnd"]]
      },
      "ops": [
        { "op": "rect", "x": 0, "y": 0, "w": 9, "h": 9, "color": "#68ad52" },
        { "op": "rect", "x": 1, "y": 1, "w": 7, "h": 3, "color": ["param", "roof"] },
        { "op": "rect", "x": 2, "y": 1, "w": 5, "h": 1, "color": ["shade", ["param", "roof"], 28] },
        { "op": "rect", "x": 1, "y": 3, "w": 7, "h": 1, "color": ["shade", ["param", "roof"], -35] },
        { "op": "rect", "x": 1, "y": 4, "w": 7, "h": 3, "color": ["param", "wall"] },
        { "op": "rect", "x": 4, "y": 5, "w": 1, "h": 2, "color": "#6b4423" },
        { "op": "win", "x": 2, "y": 5 },
        { "op": "win", "x": 6, "y": 5 },
        { "op": "if", "test": ["<", ["rnd"], 0.6], "then": [
          { "op": "rect", "x": 6, "y": 0, "w": 1, "h": 2, "color": "#7a4a3a" }] },
        { "op": "rect", "x": 0, "y": 7, "w": 9, "h": 2, "color": "#8c8f96" },
        { "op": "park", "x": 1, "y": 7, "v": 0 },
        { "op": "park", "x": 5, "y": 7, "v": 0 },
        { "op": "stat", "x": ["-", ["param", "w"], 2], "y": 0 }
      ]
    },

    "farmhouse": {
      "size": [9, 9],
      "params": { "seed": 0, "wet": null },
      "ops": [
        { "op": "rect", "x": 0, "y": 0, "w": 9, "h": 9, "color": "#7fb35a" },
        { "op": "each", "as": "x", "in": [0, 2, 4, 6, 8], "ops": [
          { "op": "pixel", "x": ["var", "x"], "y": 0, "color": "#c9a66b" },
          { "op": "pixel", "x": 0, "y": ["var", "x"], "color": "#c9a66b" }] },
        { "op": "rect", "x": 2, "y": 1, "w": 6, "h": 2, "color": "#8b3a2e" },
