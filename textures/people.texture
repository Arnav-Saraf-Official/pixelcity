// texture/2 — designs of pixel rows, conditions in short text.
// A condition chooses the design to paint, e.g. "m = 5" or "hw > 0 and night".
// Edit with the Texture Studio (npm run build, then /textures).
{
  "format": "texture/2",
  "name": "people",
  "tile": 9,
  "defs": {
    "skin": "#f1c9a0",
    "ink": "#1a1d26",
    "faces": {
      "happy": [".FFF.","FkFkF","FFFFF","kFFFk",".kkk."],
      "ok": [".FFF.","FkFkF","FFFFF","FkkkF",".FFF."],
      "sad": [".FFF.","FkFkF","FFFFF","FkkkF","kFFFk"],
      "angry": ["kFFFk","FkFkF","FFFFF","FkkkF","kFFFk"]
    },
    "faceCol": {"happy":"#5fdc7a","ok":"#ffd75e","sad":"#ff9a4d","angry":"#ff4848"}
  },
  "textures": {
    "ped": {
      "size": [1,2],
      "params": {"color":"#ff6b6b"},
      "designs": {"base":{"palette":["transparent",{"color":["def","skin"]},{"color":["param","color"]}],"rows":["1","2"]}}
    },
    "face": {
      "size": [5,5],
      "params": {"kind":"happy"},
      "default": "happy",
      "designs": {
        "happy": {
          "palette": [
            "transparent",
            {
              "color": ["choose","at(at(at(def(\"faces\"), \"happy\"), 0), 0) = \"F\"",["at",["def","faceCol"],"happy"],["def","ink"]],
              "when": "at(at(at(def(\"faces\"), \"happy\"), 0), 0) != \".\""
