{
  // ===================================================================
  // Trees. One texture, four variants: `v` picks which sides the canopy
  // leans to (bits 0 and 1) and whether the leaves are the dark palette.
  // ===================================================================
  "format": "texture/1",
  "name": "trees",
  "tile": 9,

  "defs": {
    "leafLight": "#2f7d34",
    "leafDark": "#2b6e3a",
    "leafLightHi": "#4fa84f",
    "leafDarkHi": "#3f8d4a",
    "trunk": "#6b4a2b",
    "shadow": "#14321459"
  },

  "textures": {
    "tree": {
      "size": [9, 9],
      "params": {
        "v": 1,
        "dx": ["if", ["bit", ["param", "v"], 0], 1, -1],
        "dy": ["if", ["bit", ["param", "v"], 1], 1, 0],
        "leaf": ["if", [">", ["param", "v"], 2], ["def", "leafDark"], ["def", "leafLight"]],
        "hi": ["if", [">", ["param", "v"], 2], ["def", "leafDarkHi"], ["def", "leafLightHi"]]
      },
      "ops": [
        { "op": "rect", "x": ["+", 3, ["param", "dx"]], "y": ["+", 6, ["param", "dy"]],
          "w": 4, "h": 2, "color": ["def", "shadow"] },

        { "op": "rect", "x": ["+", 4, ["param", "dx"]], "y": ["+", 5, ["param", "dy"]],
          "w": 1, "h": 2, "color": ["def", "trunk"] },

        { "op": "rect", "x": ["+", 2, ["param", "dx"]], "y": ["+", 2, ["param", "dy"]],
          "w": 5, "h": 3, "color": ["param", "leaf"] },
        { "op": "rect", "x": ["+", 3, ["param", "dx"]], "y": ["+", 1, ["param", "dy"]],
          "w": 3, "h": 5, "color": ["param", "leaf"] },

        { "op": "rect", "x": ["+", 3, ["param", "dx"]], "y": ["+", 2, ["param", "dy"]],
          "w": 2, "h": 1, "color": ["param", "hi"] }
      ]
    }
  }
}
